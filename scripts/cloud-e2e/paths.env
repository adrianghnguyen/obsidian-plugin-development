# Sourced by cloud-e2e shell scripts. Override any variable before running.

CLOUD_E2E_VAULT="${CLOUD_E2E_VAULT:-$HOME/plugin-sandbox-Obsidian}"
CLOUD_E2E_VAULT_NAME="${CLOUD_E2E_VAULT_NAME:-plugin-sandbox-Obsidian}"
CLOUD_E2E_PROFILE="${CLOUD_E2E_PROFILE:-$HOME/.obsidian-cloud-e2e-profile}"
CLOUD_E2E_OBSIDIAN_ROOT="${CLOUD_E2E_OBSIDIAN_ROOT:-$HOME/.local/opt/obsidian}"
CLOUD_E2E_OBSIDIAN_VERSION="${CLOUD_E2E_OBSIDIAN_VERSION:-1.13.7}"
CLOUD_E2E_CDP_PORT="${CLOUD_E2E_CDP_PORT:-9222}"
CLOUD_E2E_REPOS="${CLOUD_E2E_REPOS:-$HOME/repos}"
# Cloud Agent checkouts live under /agent/repos when that tree exists.
if [ -d /agent/repos ]; then
  CLOUD_E2E_REPOS=/agent/repos
fi
